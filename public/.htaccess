RewriteEngine On
RewriteBase /
Options -MultiViews
DirectoryIndex index.html

<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# Undo trailing slash on Next assets
RewriteRule ^_next/(.+)/$ /_next/$1 [L]
RewriteRule ^_next/ - [L]
RewriteRule ^(.+\.(?:js|mjs|css|map|json|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|txt|xml|html|webmanifest))/$ /$1 [L]

# Next RSC dotted names -> nested export folders
RewriteRule ^(.*)/__next\.([^/]+)\.([^/]+)\.__PAGE__\.txt$ $1/__next.$2/$3/__PAGE__.txt [L]
RewriteRule ^(.*)/__next\.([^/]+)\.([^/]+)\.txt$ $1/__next.$2/$3.txt [L]
RewriteRule ^(.*)/__next\.([^/]+)\.__PAGE__\.txt$ $1/__next.$2/__PAGE__.txt [L]

# Dynamic routes: unknown slugs reuse the fallback folder, including RSC files
RewriteRule ^courses/(?!__/)([^/]+)/(__next\..+)$ /courses/__/$2 [L]
RewriteRule ^pages/(?!__/)([^/]+)/(__next\..+)$ /pages/__/$2 [L]
RewriteRule ^mock-tests/(?!__/)([^/]+)/(__next\..+)$ /mock-tests/__/$2 [L]
RewriteRule ^live-classes/course/(?!__/)([^/]+)/(__next\..+)$ /live-classes/course/__/$2 [L]
RewriteRule ^student/courses/(?!__/)([^/]+)/learn/(__next\..+)$ /student/courses/__/learn/$2 [L]
RewriteRule ^student/mock-tests/(?!__/)([^/]+)/(instructions|exam|setup|result|analysis|solution)/(__next\..+)$ /student/mock-tests/__/$2/$3 [L]

# Existing files
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# DirectorySlash Off does not auto-serve index.html — map folders to it explicitly
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)/$ /$1/index.html [L]

RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,8}$
RewriteRule ^(.*)$ $1/ [R=301,L]

# Unknown dynamic slugs -> fallback index.html (never rewrite to a bare folder)
RewriteRule ^courses/(?!__/)([^/]+)/?$ /courses/__/index.html [L]
RewriteRule ^pages/(?!__/)([^/]+)/?$ /pages/__/index.html [L]
RewriteRule ^mock-tests/(?!__/)([^/]+)/?$ /mock-tests/__/index.html [L]
RewriteRule ^live-classes/course/(?!__/)([^/]+)/?$ /live-classes/course/__/index.html [L]
RewriteRule ^student/courses/(?!__/)([^/]+)/learn/?$ /student/courses/__/learn/index.html [L]
RewriteRule ^student/mock-tests/(?!__/)([^/]+)/(instructions|exam|setup|result|analysis|solution)/?$ /student/mock-tests/__/$2/index.html [L]

ErrorDocument 404 /404.html
